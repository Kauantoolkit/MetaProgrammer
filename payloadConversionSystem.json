{
  "appName": "conversor",
  "useAi": true,
  "entities": [
    {
      "name": "ConversionType",
      "attributes": [
        {
          "name": "id",
          "type": "number",
          "constraints": ["primary_key", "auto_increment"]
        },
        {
          "name": "input_format",
          "type": "string",
          "constraints": ["required", "max_length:20"]
        },
        {
          "name": "output_format",
          "type": "string",
          "constraints": ["required", "max_length:50"]
        },
        {
          "name": "enabled",
          "type": "boolean"
        }
      ],
      "relations": [
        {
          "target": "ConversionJob",
          "type": "1:N",
          "required": false,
          "cascade": "restrict"
        }
      ],
      "behaviors": ["soft_delete"],
      "api": {
        "endpoints": ["crud"],
        "auth": "required",
        "roles": ["admin"]
      }
    },
    {
      "name": "ConversionJob",
      "attributes": [
        {
          "name": "id",
          "type": "number",
          "constraints": ["primary_key", "auto_increment"]
        },
        {
          "name": "input_format",
          "type": "string",
          "constraints": ["required", "max_length:50"]
        },
        {
          "name": "output_format",
          "type": "string",
          "constraints": ["required"]
        },
        {
          "name": "success",
          "type": "boolean",
          "constraints": ["required"]
        },
        {
          "name": "client_ip",
          "type": "string"
        }
      ],
      "relations": [
        {
          "target": "ConversionType",
          "type": "N:1",
          "required": false,
          "cascade": "restrict"
        }
      ],
      "behaviors": ["soft_delete", "timestamps"],
      "api": {
        "endpoints": ["crud", "search"],
        "auth": "required",
        "roles": ["admin"]
      }
    },
    {
      "name": "ClientUsage",
      "attributes": [
        {
          "name": "id",
          "type": "number",
          "constraints": ["primary_key", "auto_increment"]
        },
        {
          "name": "client_ip",
          "type": "string",
          "constraints": ["required", "max_length:45"]
        },
        {
          "name": "usage_date",
          "type": "date",
          "constraints": ["required"]
        },
        {
          "name": "conversions_today",
          "type": "number",
          "constraints": ["required"]
        }
      ],
      "relations": [],
      "behaviors": [],
      "api": {
        "endpoints": ["crud"],
        "auth": "required",
        "roles": ["admin"]
      }
    }
  ],
  "functionalities": [
    {
      "name": "CheckRateLimit",
      "input": [
        { "name": "clientIp", "type": "string" }
      ],
      "output": [
        { "name": "allowed", "type": "boolean" },
        { "name": "conversionsToday", "type": "number" },
        { "name": "remainingConversions", "type": "number" }
      ],
      "entity": "ClientUsage",
      "exposeInBackoffice": false
    },
    {
      "name": "RegisterConversionJob",
      "input": [
        { "name": "clientIp", "type": "string" },
        { "name": "inputFormat", "type": "string" },
        { "name": "outputFormat", "type": "string" },
        { "name": "success", "type": "boolean" }
      ],
      "output": [
        { "name": "jobId", "type": "number" },
        { "name": "message", "type": "string" }
      ],
      "entity": "ConversionJob",
      "exposeInBackoffice": true
    },
    {
      "name": "GetConversionStats",
      "input": [
        { "name": "clientIp", "type": "string" }
      ],
      "output": [
        { "name": "totalJobs", "type": "number" },
        { "name": "successfulJobs", "type": "number" },
        { "name": "failedJobs", "type": "number" },
        { "name": "successRate", "type": "number" }
      ],
      "entity": "ConversionJob",
      "exposeInBackoffice": true
    }
  ]
}
